{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/api-server/dist",
  "env": {
    "PORT": "3001",
    "BASE_PATH": "/",
    "HOSTNAME": "0.0.0.0",
    "PLAYWRIGHT_BROWSERS_PATH": "/tmp/.playwright-browsers",
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
